data=float		# data type (byte, integer, float, double)
field=uniform		# field type (uniform, rectilinear, irregular)
coord 1 file=rec_3wzj.maps.xyz filetype=ascii offset=0
coord 2 file=rec_3wzj.maps.xyz filetype=ascii offset=2
coord 3 file=rec_3wzj.maps.xyz filetype=ascii offset=4
label=HD-affinity	# component label for variable 1
