label=Br-affinity	# component label for variable 12
label=I-affinity	# component label for variable 13
label=Si-affinity	# component label for variable 14
label=B-affinity	# component label for variable 15
label=Electrostatics	# component label for variable 16
label=Desolvation	# component label for variable 17
